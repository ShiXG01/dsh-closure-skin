{
  "name": "dsh-closure-skin",
  "version": "0.1.0",
  "private": true,
  "description": "可露希尔配套皮肤：街机像素风格，罗德岛天才工程师特供工作站",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png"
  },
  "files": [
    "lib",
    "icon.png",
    "cordis.patch.yml",
    "LICENSE-FONT",
    "FONT-NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "license": "MIT"
}
